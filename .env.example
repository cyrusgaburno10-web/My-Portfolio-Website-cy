# Primary provider — fast, cheap streaming via Groq.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional override. Defaults to llama-3.1-70b-versatile.
# If Groq has decommissioned that model on your account, check
# https://console.groq.com/docs/models and set e.g. llama-3.3-70b-versatile.
GROQ_MODEL=

# Fallback provider — used automatically when GROQ_API_KEY is not set.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Powers the "Or Send a Message" contact form on the Book a Call section.
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional owner-only settings panel. Create a Global Config store in your
# Vercel dashboard (Storage -> Global Config) and connect it to this
# project — Vercel injects this variable automatically once connected. It
# lets you change these values live, without a redeploy, from the dashboard:
#   calendlyUrl             — the Calendly booking URL
#   contactDestinationEmail — where contact form messages get sent
#   aiProvider               — "groq" or "openai", to force a provider
#   aiModel                  — override the model name for that provider
# If this isn't set, the site falls back to the hardcoded defaults.
GLOBAL_CONFIG=
